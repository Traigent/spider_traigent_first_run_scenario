# Copy to .env and fill in what you use. Nothing here is read until a run asks for it.
#
# Keep this file out of version control once it has a real value in it.

# The models this agent chooses between are all served by OpenRouter, so one key reaches
# every one of them.
OPENROUTER_API_KEY=

# Traigent's own key. It is read only when a run asks for it, so it can stay empty until
# something actually asks.
TRAIGENT_API_KEY=
