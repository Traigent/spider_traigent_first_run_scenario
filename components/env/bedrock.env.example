# Copy to .env and fill in what you use. Nothing here is read until a run asks for it.
#
# Keep this file out of version control once it has a real value in it.

# The models this agent chooses between are served by Amazon Bedrock, which signs requests
# with AWS credentials rather than an API key. Each model also has to be enabled in this
# account and this region before it will answer.
#
# Bedrock also needs the boto3 package, which the Traigent first-run guide's pinned stack
# does not install. Add it to that environment before a run reaches a model call.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Traigent's own key. Leave it empty for now -- it is not needed to look at this project,
# measure it, or run a local baseline, and it should be added only when a run actually
# reaches the point of asking for it.
TRAIGENT_API_KEY=
