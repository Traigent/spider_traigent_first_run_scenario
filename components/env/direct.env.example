# Copy to .env and fill in what you use. Nothing here is read until a run asks for it.
#
# Keep this file out of version control once it has a real value in it.

# Each model this agent can choose goes straight to its own vendor, so a model can be tried
# once the key for that vendor is filled in. One key is enough for the models it serves;
# trying every model in the roster needs a key for each vendor in it.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Traigent's own key. It is read only when a run asks for it, so it can stay empty until
# something actually asks.
TRAIGENT_API_KEY=
